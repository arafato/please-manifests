{
  "name": "bat",
  "executable": "bat",
  "description": "A cat(1) clone with syntax highlighting and Git integration.",
  "homepage": "https://github.com/sharkdp/bat",
  "license": "Apache-2.0",
  "categories": ["syntax-highlighting", "terminal"],
  "image": "docker.io/efrecon/bat",
  "version_discovery": {
    "filter": {
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$",
      "exclude": ["latest", "edge", "rc", "beta", "alpha", "dev"]
    }
  },
  "script": "standard",
  "platforms": ["linux/amd64"],
  "application_args": ["--color=always"],
  "container_args": {
    "dns": ["8.8.8.8"],
    "workdir": "/mnt",
    "volumes": ["$(pwd):/mnt"],
    "additional_flags": []
  }
}
