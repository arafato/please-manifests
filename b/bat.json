{
  "name": "bat",
  "description": "A cat(1) clone with syntax highlighting and Git integration.",
  "homepage": "https://github.com/sharkdp/bat",
  "license": "Apache-2.0",
  "categories": ["syntax-highlighting", "terminal"],
  "image": "docker.io/efrecon/bat",
  "versions": ["v0.26.1", "v0.26.0", "v0.25.0", "v0.24.0"],
  "default_version": "v0.26.1",
  "script": "standard",
  "platform": "linux/amd64",
  "application_args": ["--color=always"],
  "container_args": {
    "dns": ["8.8.8.8"],
    "workdir": "/mnt",
    "volumes": ["$(pwd):/mnt"],
    "additional_flags": ["--platform linux/amd64"]
  }
}
