{
  "name": "terraform",
  "exec": "terraform",
  "description": "Infrastructure as Code tool for building, changing, and versioning infrastructure",
  "homepage": "https://www.terraform.io/",
  "license": "BUSL-1.1",
  "categories": ["infrastructure", "iac", "cloud"],
  "image": "docker.io/hashicorp/terraform",
  "version_discovery": {
    "filter": {
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$",
      "exclude": ["latest", "edge", "rc", "beta", "alpha", "dev"]
    }
  },
  "script": "standard",
  "platforms": ["linux/amd64", "linux/arm64"],
  "container_args": {
    "dns": ["8.8.8.8"],
    "workdir": "/mnt",
    "volumes": ["$(pwd):/mnt"],
    "additional_flags": []
  }
}
